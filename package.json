{
  "name": "sourx-exchange",
  "version": "1.0.0",
  "private": true,
  "description": "SourX Exchange compute marketplace control plane",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.frontend.json && vite build",
    "build:server": "tsc -p tsconfig.json",
    "build:web": "vite build",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run build && npm test",
    "dev:web": "vite --host 127.0.0.1",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.frontend.json",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.10.7",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "7.1.7",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.8.0"
}
